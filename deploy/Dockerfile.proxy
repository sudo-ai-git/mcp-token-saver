# mcp-token-saver PROXY — deployable as a Fly service (or any Docker host)
# The proxy dedupes/caches in the request path BEFORE forwarding to an upstream
# OpenAI-compatible provider (`UPSTREAM_BASE_URL`).
#
# Run locally:
#   UPSTREAM_BASE_URL=https://api.openai.com/v1 python3 proxy_server.py
#
# Deploy to Fly:
#   cp proxy_server.py proxy_optimize.py ./
#   fly launch --name mcp-token-saver-proxy --no-deploy   # (once)
#   fly secrets set UPSTREAM_BASE_URL=...                 # the provider to front
#   fly deploy
FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir --quiet --upgrade pip
COPY proxy_optimize.py /app/
COPY proxy_server.py /app/
ENV PYTHONUNBUFFERED=1
ENV PORT=8080
ENV PROXY_PORT=8080
EXPOSE 8080
CMD ["python3", "proxy_server.py"]
